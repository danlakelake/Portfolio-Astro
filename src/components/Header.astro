---
import { Menu, X, Globe } from '@lucide/astro';

// Define las propiedades
interface MenuItem {
  label: string;
  href: string;
}

// Etiquetas y Menu links
const menuItems: MenuItem[] = [
  { label: 'Sobre mí', href: '#about-me' },
  { label: 'Experiencia', href: '#experiences' },
  { label: 'Proyectos', href: '#projects' },
  { label: 'Contacto', href: '#contact' },
];
---

<!-- Language Switch & Responsive Menu -->
<div
  class="flex w-full justify-between items-center px-0 md:px-12 py-2 md:justify-end"
>
  <!-- Language Switch -->
  <button
    id="langSwitch"
    class="flex items-center gap-2 rounded-full bg-primary px-4 py-2 font-bold text-white shadow-md transition cursor-pointer"
    aria-label="Cambiar idioma"
  >
    <Globe size={18} class="stroke-2" />
    <span>EN</span>
  </button>

  <!-- Responsive Menu -->
  <button
    id="menuToggle"
    class="text-2xl cursor-pointer md:hidden"
    aria-label="Abrir menú"
    aria-expanded="false"
  >
    <span class="relative block size-7.5">
      <Menu id="iconOpen" size={30} class="menu-icon" />
      <X id="iconClose" size={30} class="menu-icon" />
    </span>
  </button>
</div>

<!-- Menu -->
<nav id="mainMenu" class="menu-transition md:flex justify-center my-0 z-1">
  <ul
    class="block px-2 md:px-13 py-4 md:py-3 space-x-4 md:space-x-6 space-y-4 md:space-y-0 text-sm font-medium md:flex border-none border border-main-gray rounded-md md:rounded-4xl shadow-none md:shadow-md sm:bg-transparent md:bg-background"
  >
    {
      menuItems.map((item) => (
        <li class="menu-links">
          <a href={item.href}>{item.label}</a>
        </li>
      ))
    }
  </ul>
</nav>

<!-- Js -->
<script>
  const menuToggle = document.getElementById('menuToggle');
  const menuList = document.getElementById('mainMenu');

  // Switch iconos, menu responsive y rotación
  menuToggle?.addEventListener('click', () => {
    const isOpen = menuToggle.classList.toggle('menu-open');

    menuList?.classList.toggle('menu-transition-open', isOpen);

    menuToggle.setAttribute('aria-expanded', String(isOpen));
    menuToggle.setAttribute(
      'aria-label',
      isOpen ? 'Cerrar menú' : 'Abrir menú',
    );
  });
</script>
