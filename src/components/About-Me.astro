---
import type { Profile } from '../schemas/wordpress';
import { Icon } from 'astro-icon/components';

interface Props {
  profile: Profile;
  description: string;
}

const { profile, description } = Astro.props;
---

<section
  id="sobre-mi"
  class="flex max-w-2xl flex-col items-start space-y-6 px-0 md:px-8 pt-7 pb-10 md:pt-16 md:pb-16"
>
  <!-- Imagen de Perfil -->
  <div
    class="h-17 w-17 cursor-pointer overflow-hidden rounded-full shadow-md transition-transform duration-300 hover:scale-130"
  >
    <img
      src={profile.acf.profile_image}
      alt={profile.acf.profile_name}
      class="h-full w-full scale-110 object-cover"
    />
  </div>

  <!-- Acerca De -->
  <h1 class="text-4xl font-bold tracking-tight">
    ¡Hola!, Soy {' '}
    <span
      id="nameLink"
      class="cursor-pointer text-primary transition-all duration-200 hover:text-5xl"
    >
      {profile.acf.profile_name.split(' ')[0]}
      <span class="ml-2 emoji-wave">👋🏻</span>
      <span class="ml-2 emoji-happy">😁</span>
    </span>
  </h1>

  <!-- Descripción -->
  <p class="text-base text-gray-500 italic">
    {description}
  </p>
  
  <!-- Social -->
  <div class="flex space-x-5">
    <a
      href={profile.acf.linkedin_url}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="LinkedIn"
      class="text-gray-400 transition hover:text-primary"
    >
      <Icon
        name="simple-icons:linkedin"
        class="size-7 transition-transform duration-200 hover:scale-150"
      />
    </a>
    <a
      href={profile.acf.github_url}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="GitHub"
      class="text-gray-400 transition hover:text-primary"
    >
      <Icon
        name="simple-icons:github"
        class="size-7 transition-transform duration-200 hover:scale-150"
      />
    </a>
    <a
      href={profile.acf.behance_url}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Behance"
      class="text-gray-400 transition hover:text-primary"
    >
      <Icon
        name="simple-icons:behance"
        class="size-7 transition-transform duration-200 hover:scale-150"
      />
    </a>
  </div>
</section>
