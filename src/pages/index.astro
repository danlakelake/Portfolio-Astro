---
import Layout from '../layouts/Layout.astro';
import  Header  from "../components/Header.astro";
import  AboutMe  from "../components/About-Me.astro";

import { getProjects, getExperiences, getProfile } from '../lib/wordpress';

// Obtiene Profile
const profile = await getProfile();
// Obtiene proyectos
const projects = await getProjects();
// Obtiene Experiencias
const experiences = await getExperiences();

// Elimina las etiquetas HTML y normaliza los espacios de la descripción
const description = profile.content.rendered
  .replace(/<[^>]*>/g, '')
  .replace(/\s+/g, ' ')
  .trim();
---

<Layout
  profileName={profile.acf.profile_name}
  description={description}
  image={profile.acf.profile_image}
>
  <!-- Hoja envolvente -->
  <div class="paper-texture mx-auto min-h-screen max-w-6xl px-6 py-2 sm:px-8 md:py-5 lg:px-30 shadow-lg">
    <!-- Header -->
    <Header/>
    <AboutMe profile={profile} description={description}/>
    <main>
      <!-- Portfolio sections -->
    </main>
    <!-- Footer -->
  </div>
</Layout>
