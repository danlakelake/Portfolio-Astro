---
import Layout from '../layouts/Layout.astro';
import { getProjects, getExperiences, getProfile } from '../lib/wordpress';

const projects = await getProjects();
const experiences = await getExperiences();
const profile = await getProfile();

const description = profile.content.rendered
  .replace(/<[^>]*>/g, '')
  .replace(/\s+/g, ' ')
  .trim();
---

<Layout
  profileName={profile.acf.profile_name}
  description={description}
  image={profile.acf.profile_image}
>
  <main class="flex min-h-screen items-center justify-center bg-slate-950">
    <h1 class="text-5xl font-bold text-white">Portfolio</h1>
  </main>
</Layout>